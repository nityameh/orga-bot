{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "sin1"
  ],
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "prompts/**",
      "excludeFiles": "{node_modules/@huggingface/**,node_modules/onnxruntime-node/**,node_modules/onnxruntime-web/**,node_modules/sharp/**,.cache/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
