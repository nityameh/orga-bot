generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  phone     String?    @unique           // WhatsApp number e.g. "919876543210"; null for Telegram-only users
  tier      String     @default("free")  // "free" | "pro" | "team"
  lang      String     @default("en")    // "en" | "hi"
  createdAt DateTime   @default(now())
  notes          Note[]
  tasks          Task[]
  reminders      Reminder[]
  pendingActions PendingAction[]
  loginTokens    LoginToken[]
  sessions       Session[]
  identities     ChannelIdentity[]
  interactions   Interaction[]
  linkCodes      LinkCode[]
  conversation   ConversationMessage[]
  integrations   Integration[]
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  title     String                        // clean summary from Claude
  body      String?                       // full original text
  tags      String[]                      // ["#acme", "#design", "#work"]
  client     String?                       // extracted client name
  project    String?                       // extracted project name
  pinned     Boolean   @default(false)     // user can pin important notes
  archivedAt DateTime?                     // archived notes hidden from default view
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?                     // soft delete — recoverable for 30 days
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, tags])
  @@index([userId, pinned])
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  title     String                        // task list name
  items     Json                          // [{ id, text, done, order }]
  tags      String[]
  client    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  title       String
  fireAt      DateTime                    // when to send the WA message
  status      String    @default("pending") // "pending" | "fired" | "done" | "snoozed"
  snoozeUntil DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, fireAt])              // critical — used by cron job every 60s
}

model PendingAction {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "note_list" | "task_list" | "reminder_list" | "edit_note"
  items     Json     // [{ pos: 1, id: "cuid", summary: "title" }, ...]
  expiresAt DateTime // now + 10 minutes
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Dashboard auth — see docs/adr/ADR-006-dashboard-authentication.md
// One-time magic-link token sent over the user's chat. Only the SHA-256 hash is stored.
model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Server-side dashboard session. The cookie holds a random id; only its hash is stored.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per chat account that reaches Orga (ADR-003). A user can have several
// (WhatsApp + Telegram) after linking. lastInboundAt drives channel choice and
// the WhatsApp 24-hour free-form window.
model ChannelIdentity {
  id            String    @id @default(cuid())
  userId        String
  channel       String                       // "whatsapp" | "telegram"
  externalId    String                       // phone number or Telegram chat id
  displayName   String?
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([userId])
}

// Short-lived code for linking another channel to an existing account.
model LinkCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Append-only event log: the backbone for analytics, audit and proactive
// features (ADR-005). Kinds are listed in src/interactions/kinds.js.
model Interaction {
  id         String   @id @default(cuid())
  userId     String
  kind       String
  channel    String?
  person     String?                         // client / person the event concerns
  summary    String?
  payload    Json?
  traceId    String?
  tokensIn   Int?
  tokensOut  Int?
  costMicros Int?                            // LLM cost in millionths of a USD
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
  @@index([userId, person, createdAt])
}

// Short-term conversation memory for the agent (ADR-004): the last few turns
// as plain text so follow-ups like "make it 5pm instead" work. Pruned after
// 7 days by the cleanup job; deleted with the user.
model ConversationMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String                           // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Connected third-party account (ADR-010). Tokens are AES-256-GCM encrypted by
// src/integrations/tokenVault.js and never leave the server or appear in logs.
model Integration {
  id              String    @id @default(cuid())
  userId          String
  provider        String                       // "google"
  accountEmail    String?
  accessTokenEnc  String
  refreshTokenEnc String?
  scopes          String[]
  expiresAt       DateTime
  status          String    @default("active") // "active" | "expired"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}
