# Production secrets for the Vercel API project (ADR-020).
#   1. cp .env.vercel.example .env.vercel        (gitignored, never commit it)
#   2. fill in the values below
#   3. npm run vercel:env                         (pushes every non-empty line to Vercel → Production;
#                                                  values are never printed)
# Optional variables can stay empty; empty lines are skipped.

# Supabase → Connect → Transaction pooler (port 6543). Append: ?pgbouncer=true&connection_limit=1
DATABASE_URL=
# Supabase → Connect → Session pooler (port 5432), same password. Used by migrations at build time.
DIRECT_URL=

# console.groq.com → API Keys (free)
GROQ_API_KEY=

# openssl rand -hex 24. Also goes into cron-job.org as the header "Authorization: Bearer <value>".
CRON_SECRET=

# The dashboard's Vercel URL, e.g. https://orga-dashboard.vercel.app (no trailing slash)
DASHBOARD_URL=

NODE_ENV=production

# ── Optional ──
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
