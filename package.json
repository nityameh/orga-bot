{
  "name": "orga-bot",
  "version": "1.0.0",
  "description": "WhatsApp-native productivity bot for Indian freelancers",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "evals:legacy": "vitest run --dir evals --config vitest.evals.config.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:gen": "prisma generate",
    "docs": "node scripts/gen-lld.js",
    "verify": "npm run lint && npm run typecheck && npm test",
    "hooks:setup": "git config core.hooksPath .githooks && chmod +x .githooks/* && echo 'Git hooks activated'",
    "evals": "node evals/run-agent-evals.js",
    "embeddings:check": "node scripts/check-embedder.js",
    "embeddings:backfill": "node scripts/backfill-embeddings.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@huggingface/transformers": "^4.3.2",
    "@prisma/client": "^5.22.0",
    "axios": "^1.21.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "groq-sdk": "^1.1.1",
    "node-cron": "^3.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "nodemon": "^3.1.9",
    "playwright": "^1.58.2",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
