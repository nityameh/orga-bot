{
  "name": "orga-bot",
  "version": "1.0.0",
  "description": "WhatsApp-native productivity bot for Indian freelancers",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:push": "prisma db push",
    "db:gen": "prisma generate",
    "docs": "node scripts/gen-lld.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "hooks:setup": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit && echo 'Git hooks activated'"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^1.1.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "playwright": "^1.58.2",
    "prisma": "^5.22.0",
    "vitest": "^4.1.2"
  }
}
