# Meta / WhatsApp
WHATSAPP_TOKEN=          # Permanent system user token from Meta Business Manager
PHONE_NUMBER_ID=         # From Meta Developer Portal → WhatsApp → API Setup
WEBHOOK_VERIFY_TOKEN=    # You define this string. Meta echoes it back during setup.
APP_SECRET=              # From Meta Developer Portal → App Settings → Basic

# Database (local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orga_dev
DIRECT_URL=${DATABASE_URL}     # migrations; on Vercel use Supabase's session pooler (5432) here and the transaction pooler (6543) above

# AI — using Groq for dev (free, no card needed)
GROQ_API_KEY=            # From console.groq.com → API Keys → Create API Key

# App
PORT=3000
NODE_ENV=development

# Dashboard + auth (ADR-006)
DASHBOARD_URL=http://localhost:3001   # Used for magic links and CORS. Must be https in production.
LOGIN_TOKEN_TTL_MINUTES=10
SESSION_TTL_DAYS=30

# Telegram (optional) — create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=   # Random string; Telegram echoes it in a header. Required in production if the token is set.

# Agent (ADR-004) — provider "auto" uses Anthropic if ANTHROPIC_API_KEY is set, else Groq, else the legacy classifier
ANTHROPIC_API_KEY=
AGENT_PROVIDER=auto            # auto | anthropic | groq | off
AGENT_MODEL=                   # default: claude-opus-5-5 (anthropic) / llama-3.3-70b-versatile (groq)
AGENT_EFFORT=low               # low | medium | high (Anthropic only)
AGENT_MAX_STEPS=6
AGENT_LLM_TIMEOUT_MS=25000      # per model call; then fail over to the next provider
AGENT_DAILY_TOKEN_BUDGET=300000  # per user per IST day; over budget → legacy classifier

# Google Calendar + Gmail (Phase 3). Create an OAuth client (Web application) in Google Cloud Console,
# add the redirect URI below, keep the consent screen in "Testing" (≤100 test users, no verification).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
TOKEN_ENC_KEY=                 # openssl rand -base64 32 — encrypts OAuth tokens at rest

# Memory / semantic search (Phase 4) — free local embeddings (downloads ~120 MB once)
EMBEDDINGS=local               # local | off
EMBEDDING_MODEL=Xenova/multilingual-e5-small
MODEL_CACHE_DIR=.cache/models

# Background jobs — pgboss (durable queue in Postgres, default) | cron (fallback)
JOBS=pgboss

# Runtime (ADR-020): server | serverless. Default: serverless when VERCEL is set, else server.
# RUNTIME=server
# Serverless only: an external cron calls POST /internal/tick with "Authorization: Bearer <CRON_SECRET>".
# Required in production on serverless. Generate: openssl rand -hex 24
CRON_SECRET=

# Proactive messages
PROACTIVE_DAILY_LIMIT=3        # max unprompted messages per user per day

# Database pool size for pg-boss and the LangGraph checkpointer (keep small on free poolers)
DB_POOL_MAX=3
