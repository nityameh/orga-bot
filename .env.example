# ══════════════════════════════════════════════════════════════════════════════
#  Orga environment variables
#  Local dev:   cp .env.example .env   and fill in what you need (most are optional).
#  Production:  cp .env.vercel.example .env.vercel, fill it in, run `npm run vercel:env`
#               (pushes it to the Vercel API project). See docs/DEPLOY.md.
#  Never commit .env or .env.vercel: both are gitignored.
# ══════════════════════════════════════════════════════════════════════════════
#
#  SECRETS CHECKLIST: what you need, where to get it, and where it goes
#  ┌───────────────────────────┬──────────────────────────────────────────────┬──────────┬──────────────┐
#  │ Variable                  │ Where to get it                              │ Local    │ Production   │
#  ├───────────────────────────┼──────────────────────────────────────────────┼──────────┼──────────────┤
#  │ DATABASE_URL              │ local Postgres / Supabase → Connect →        │ required │ required     │
#  │                           │   Transaction pooler (6543)                  │          │              │
#  │ DIRECT_URL                │ Supabase → Connect → Session pooler (5432)   │ = above  │ required     │
#  │ GROQ_API_KEY              │ console.groq.com → API Keys (free)           │ optional │ recommended  │
#  │ CRON_SECRET               │ generate: openssl rand -hex 24               │ —        │ required*    │
#  │ DASHBOARD_URL             │ the dashboard's URL (Vercel)                 │ default  │ required     │
#  │ ANTHROPIC_API_KEY         │ console.anthropic.com (paid)                 │ optional │ optional     │
#  │ TELEGRAM_BOT_TOKEN        │ Telegram → @BotFather → /newbot              │ optional │ optional     │
#  │ TELEGRAM_WEBHOOK_SECRET   │ generate: openssl rand -hex 24               │ optional │ if Telegram  │
#  │ GOOGLE_CLIENT_ID/_SECRET  │ Google Cloud Console → OAuth client (Web)    │ optional │ optional     │
#  │ TOKEN_ENC_KEY             │ generate: openssl rand -base64 32            │ if Google│ if Google    │
#  │ WHATSAPP_* / APP_SECRET   │ Meta Developer Portal (all 4 or none)        │ optional │ optional     │
#  └───────────────────────────┴──────────────────────────────────────────────┴──────────┴──────────────┘
#  * CRON_SECRET is required on Vercel (serverless); unused on Render/VM.
#  Without any LLM key the agent is off and Orga uses its keyword classifier.
#  Dashboard (Vercel project with root `dashboard`) needs just one variable:
#     API_ORIGIN = https://<api-project>.vercel.app   (not a secret)
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
# Local: your own Postgres with pgvector. Production (Vercel): Supabase transaction
# pooler, port 6543, with ?pgbouncer=true&connection_limit=1 appended.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orga_dev
# Used only by migrations. Local: same as DATABASE_URL. Production: Supabase session pooler (5432).
DIRECT_URL=${DATABASE_URL}

# ── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=                  # SECRET · free · console.groq.com → API Keys
ANTHROPIC_API_KEY=             # SECRET · optional, paid · preferred when set (AGENT_PROVIDER=auto)
AGENT_PROVIDER=auto            # auto | anthropic | groq | off
AGENT_MODEL=                   # default: claude-opus-5-5 (anthropic) / llama-3.3-70b-versatile (groq)
AGENT_EFFORT=low               # low | medium | high (Anthropic only)
AGENT_MAX_STEPS=6
AGENT_LLM_TIMEOUT_MS=25000     # per model call; then fail over to the next provider
AGENT_DAILY_TOKEN_BUDGET=300000  # per user per IST day; over budget → keyword classifier

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development           # production on Vercel/Render

# ── Dashboard + auth (ADR-006) ───────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3001   # used in invite/login links and CORS; https in production
LOGIN_TOKEN_TTL_MINUTES=10
SESSION_TTL_DAYS=30

# ── Serverless scheduler (ADR-020) ───────────────────────────────────────────
# RUNTIME=server               # server | serverless (default: serverless when Vercel sets VERCEL)
CRON_SECRET=                   # SECRET · openssl rand -hex 24 · cron-job.org sends "Authorization: Bearer <this>"

# ── Telegram (optional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # SECRET · @BotFather → /newbot
TELEGRAM_WEBHOOK_SECRET=       # SECRET · openssl rand -hex 24 · required in production when the token is set

# ── WhatsApp / Meta (optional: set all four or none) ─────────────────────────
WHATSAPP_TOKEN=                # SECRET · Meta Business Manager → system user token
PHONE_NUMBER_ID=               # Meta Developer Portal → WhatsApp → API Setup
WEBHOOK_VERIFY_TOKEN=          # SECRET · any string you choose; Meta echoes it during setup
APP_SECRET=                    # SECRET · Meta Developer Portal → App Settings → Basic

# ── Google Calendar + Gmail (optional, Phase 3) ──────────────────────────────
# OAuth client (Web application) in Google Cloud Console; add the redirect URI below;
# keep the consent screen in "Testing" (≤100 test users, no verification needed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=          # SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback   # production: https://<api>/oauth/google/callback
TOKEN_ENC_KEY=                 # SECRET · openssl rand -base64 32 · encrypts OAuth tokens at rest

# ── Memory / semantic search (Phase 4) ───────────────────────────────────────
EMBEDDINGS=local               # local | off (forced off on Vercel: the model doesn't fit a function)
EMBEDDING_MODEL=Xenova/multilingual-e5-small
MODEL_CACHE_DIR=.cache/models

# ── Background jobs & pools ──────────────────────────────────────────────────
JOBS=pgboss                    # pgboss | cron (server mode only; Vercel uses /internal/tick)
DB_POOL_MAX=3                  # pg-boss + LangGraph pools (Vercel defaults to 1)
PROACTIVE_DAILY_LIMIT=3        # max unprompted messages per user per day
